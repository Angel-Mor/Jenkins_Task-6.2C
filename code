pipeline {
    agent any

    stages {
        stage('Check Maven Installation') {
            steps {
                script {
                    // Verify Maven is installed and in PATH
                    def mavenHome = tool name: 'code', type: 'maven'
                    env.PATH = "${mavenHome}/bin:${env.PATH}"
                    sh 'mvn --version'
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    echo 'Building the application using Maven...'
                    sh 'mvn clean package'
                }
            }
            post {
                failure {
                    mail to: 'angel4761.be23@chitkara.edu.in',
                         subject: "Build Failed - ${env.JOB_NAME}",
                         body: "Build stage failed. Please check Jenkins logs.\n\nBuild URL: ${env.BUILD_URL}"
                }
            }
        }

        stage('Unit and Integration Tests') {
            steps {
                script {
                    echo 'Running unit and integration tests...'
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                    archiveArtifacts artifacts: '**/target/surefire-reports/*.xml', allowEmptyArchive: true
                    mail to: 'angel4761.be23@chitkara.edu.in',
                         subject: "Test Results - ${env.JOB_NAME}",
                         body: "Tests completed. Status: ${currentBuild.currentResult}\n\nBuild URL: ${env.BUILD_URL}"
                }
            }
        }

        stage('Code Analysis') {
            steps {
                script {
                    echo 'Performing static code analysis...'
                    sh 'mvn sonar:sonar -Dsonar.projectKey=jenkins-task'
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    echo 'Running security scan...'
                    sh 'mvn org.owasp:dependency-check-maven:check'
                    archiveArtifacts artifacts: '**/target/dependency-check-report.html', allowEmptyArchive: true
                }
            }
            post {
                always {
                    mail to: 'angel4761.be23@chitkara.edu.in',
                         subject: "Security Scan Results - ${env.JOB_NAME}",
                         body: "Security scan completed. Status: ${currentBuild.currentResult}\n\nBuild URL: ${env.BUILD_URL}"
                }
            }
        }

        stage('Deploy to Staging') {
            steps {
                script {
                    echo 'Deploying to staging environment...'
                    // Replace with actual deployment commands
                    sh 'echo "Simulated deployment to staging"'
                }
            }
        }

        stage('Integration Tests on Staging') {
            steps {
                script {
                    echo 'Running integration tests on staging...'
                    sh 'mvn verify -Denvironment=staging'
                }
            }
        }

        stage('Deploy to Production') {
            steps {
                script {
                    echo 'Deploying to production environment...'
                    // Replace with actual deployment commands
                    sh 'echo "Simulated deployment to production"'
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline completed. Cleaning up...'
        }
    }
}
