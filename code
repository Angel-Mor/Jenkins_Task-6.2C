pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building the application...'
                sh 'mvn clean package'
            }
            post {
                failure {
                    emailext body: 'Build stage failed! Check Jenkins for details.', subject: 'Build Failed', to: 'angel4761.be23@chitkara.edu.in'
                }
            }
        }

        stage('Unit and Integration Tests') {
            steps {
                echo 'Running unit and integration tests...'
                sh 'mvn test'
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                    emailext body: 'Unit and Integration Tests completed. Status: ${currentBuild.currentResult}', 
                            subject: 'Test Results', 
                            to: 'angel4761.be23@chitkara.edu.in',
                            attachmentsPattern: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Code Analysis') {
            steps {
                echo 'Running code analysis...'
                withSonarQubeEnv('sonar-server') {
                    sh 'mvn sonar:sonar'
                }
            }
            post {
                failure {
                    emailext body: 'Code analysis failed! Check Jenkins for details.', subject: 'Code Analysis Failed', to: 'angel4761.be23@chitkara.edu.in'
                }
            }
        }

        stage('Security Scan') {
            steps {
                echo 'Running security scan...'
                dependencyCheck additionalArguments: '--scan ./ --format XML --out ./', odcInstallation: 'OWASP-DC'
                dependencyCheckPublisher pattern: 'dependency-check-report.xml'
            }
            post {
                always {
                    emailext body: 'Security scan completed. Status: ${currentBuild.currentResult}', 
                            subject: 'Security Scan Results', 
                            to: 'angel4761.be23@chitkara.edu.in',
                            attachmentsPattern: 'dependency-check-report.xml'
                }
            }
        }

        stage('Deploy to Staging') {
            steps {
                echo 'Deploying to staging environment...'
                sh 'echo "Simulating deployment to staging"'
            }
        }

        stage('Integration Tests on Staging') {
            steps {
                echo 'Running integration tests on staging...'
                sh 'mvn verify -Denvironment=staging'
            }
        }

        stage('Deploy to Production') {
            steps {
                echo 'Deploying to production environment...'
                sh 'echo "Simulating deployment to production"'
            }
        }
    }
}
