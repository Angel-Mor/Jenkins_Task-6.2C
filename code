pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Build: Using Maven to compile and package the code'
                // Example: sh 'mvn clean install'
            }
        }

        stage('Test') {
            steps {
                echo 'Test: Running unit and integration tests with JUnit'
                // Example: sh 'mvn test'
            }
            post {
                always {
                    emailext(
                        subject: "Test Stage Result: ${currentBuild.fullDisplayName}",
                        body: "Tests completed. Status: ${currentBuild.currentResult}\nBuild URL: ${env.BUILD_URL}",
                        to: 'angel4761.be23@chitkara.edu.in',
                        attachLog: true
                    )
                }
            }
        }

        stage('Code Analysis') {
            steps {
                echo 'Code Analysis: Using SonarQube to check code quality'
                // Example: sh 'mvn sonar:sonar'
            }
        }

        stage('Security Scan') {
            steps {
                echo 'Security Scan: Using OWASP ZAP to check for vulnerabilities'
                // Example: sh './zap-scan.sh'
            }
            post {
                always {
                    emailext(
                        subject: "Security Scan Result: ${currentBuild.fullDisplayName}",
                        body: "Security scan completed. Status: ${currentBuild.currentResult}\nBuild URL: ${env.BUILD_URL}",
                        to: 'angel4761.be23@chitkara.edu.in',
                        attachLog: true
                    )
                }
            }
        }

        stage('Deploy to Staging') {
            steps {
                echo 'Deploy: Sending application to staging server'
                // Example: sh './deploy-staging.sh'
            }
        }

        stage('Test on Staging') {
            steps {
                echo 'Test: Running integration tests on staging server'
                // Example: sh './run-tests.sh'
            }
        }

        stage('Deploy to Production') {
            steps {
                echo 'Deploy: Sending application to production server'
                // Example: sh './deploy-prod.sh'
            }
        }
    }

    post {
        success {
            emailext(
                subject: "Pipeline Success: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "The pipeline completed successfully.\nBuild URL: ${env.BUILD_URL}",
                to: 'angel4761.be23@chitkara.edu.in'
            )
        }
        failure {
            emailext(
                subject: "Pipeline Failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "The pipeline failed. Check the logs for more info.\nBuild URL: ${env.BUILD_URL}",
                to: 'angel4761.be23@chitkara.edu.in',
                attachLog: true
            )
        }
    }
}
