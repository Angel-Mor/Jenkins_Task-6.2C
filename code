pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                script {
                    echo '[Build] Starting project build process using Maven...'
                    echo 'Tool used: Maven (can be adapted to Gradle or npm as per tech stack)'
                }
            }
        }

        stage('Testing') {
            steps {
                script {
                    echo '[Testing] Executing unit tests with JUnit and integration tests using Selenium...'
                    echo 'Tools involved: JUnit for backend logic and Selenium for UI validation'
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                script {
                    echo '[Code Quality Check] Performing static code analysis to maintain code quality...'
                    echo 'Selected tool: SonarQube'
                }
            }
        }

        stage('Security Verification') {
            steps {
                script {
                    echo '[Security Audit] Running vulnerability assessment on the codebase...'
                    echo 'Chosen tool: OWASP ZAP (others like Trivy/Snyk also valid)'
                }
            }
        }

        stage('Staging Deployment') {
            steps {
                script {
                    echo '[Staging] Deploying application to test environment (staging)...'
                    echo 'Deployment managed via Docker or automation tools like Ansible'
                }
            }
        }

        stage('Tests on Staging') {
            steps {
                script {
                    echo '[Staging Verification] Validating deployed application through integration/API tests...'
                    echo 'Tool: Postman CLI or Newman for automated testing'
                }
            }
        }

        stage('Production Deployment') {
            steps {
                script {
                    echo '[Production] Deploying final version to live environment...'
                    echo 'Using Jenkins and deployment tools like Docker or Kubernetes'
                }
            }
        }
    }

    post {
        always {
            script {
                echo 'Triggering email notification after pipeline execution...'
                mail (
                    subject: "Build Pipeline Completed: ${env.JOB_NAME} - Run #${env.BUILD_NUMBER}",
                    body: "Hello,\n\nThe Jenkins pipeline has finished executing.\nCheck the result here: ${env.BUILD_URL}\n\nRegards,\nCI Server",
                    to: 'angel4761.be23@chitkara.edu.in'
                )
            }
        }
    }
}
