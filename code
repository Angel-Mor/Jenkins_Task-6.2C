pipeline {
    agent any
    
    tools {
        // Must exactly match your Maven installation name in Jenkins
        maven 'M3'  
    }

    stages {
        stage('Initialize') {
            steps {
                echo 'Starting CI/CD pipeline...'
                git branch: 'main', 
                     url: 'https://github.com/Angel-Mor/Jenkins_Task-6.2C.git',
                     credentialsId: '' // Add credential ID if private repo
                dir('code') {  // Enter your code directory
                    echo 'Repository cloned successfully'
                }
            }
        }

        stage('Build') {
            steps {
                dir('code') {  // Build inside your code directory
                    echo 'Building application with Maven...'
                    script {
                        try {
                            sh 'mvn --version'
                            sh 'mvn clean package'
                            echo 'Build completed successfully'
                        } catch (Exception e) {
                            echo "Build failed: ${e}"
                            currentBuild.result = 'FAILURE'
                            error('Build stage failed')
                        }
                    }
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('code') {
                    echo 'Running JUnit tests...'
                    script {
                        sh 'mvn test'
                        echo 'Unit tests executed'
                    }
                }
            }
            post {
                always {
                    junit 'code/target/surefire-reports/*.xml'  // Updated path
                }
            }
        }

        stage('Code Analysis') {
            steps {
                dir('code') {
                    echo 'Running SonarQube analysis...'
                    script {
                        sh 'mvn sonar:sonar -Dsonar.projectKey=jenkins-task'
                        echo 'Code analysis completed'
                    }
                }
            }
        }

        stage('Security Scan') {
            steps {
                dir('code') {
                    echo 'Running OWASP Dependency-Check...'
                    script {
                        sh 'mvn dependency-check:check'
                        echo 'Security scan completed'
                    }
                }
            }
        }

        stage('Deploy to Staging') {
            steps {
                echo 'Deploying to AWS EC2 staging...'
                script {
                    sh 'echo "Simulating deployment to staging EC2 instance"'
                    echo 'Staging deployment simulated'
                }
            }
        }

        stage('Staging Tests') {
            steps {
                echo 'Running Postman tests on staging...'
                script {
                    sh 'echo "Simulating Postman tests on staging"'
                    echo 'Staging tests simulated'
                }
            }
        }

        stage('Deploy to Production') {
            steps {
                echo 'Deploying to AWS EC2 production...'
                script {
                    sh 'echo "Simulating deployment to production EC2 instance"'
                    echo 'Production deployment simulated'
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution completed'
            archiveArtifacts artifacts: 'code/target/*.jar', allowEmptyArchive: true
        }
        success {
            mail to: 'angel4761.be23@chitkara.edu.in',
                 subject: "SUCCESS: Pipeline ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: """All stages completed successfully!
                 
                 Build URL: ${env.BUILD_URL}
                 """
            echo 'Success email sent'
        }
        failure {
            mail to: 'angel4761.be23@chitkara.edu.in',
                 subject: "FAILED: Pipeline ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: """Pipeline failed at stage: ${currentBuild.currentResult}
                 
                 Build URL: ${env.BUILD_URL}
                 """
            echo 'Failure email sent'
        }
    }
}
