pipeline {
    agent any

    stages {
        // Stage 1: Code Compilation
        stage('Compile Source Code') {
            steps {
                script {
                    echo 'Compiling application using Maven'
                    sh 'mvn clean compile || echo "Compilation failed"'
                }
            }
        }

        // Stage 2: Automated Testing
        stage('Execute Test Suite') {
            steps {
                script {
                    echo 'Running JUnit tests'
                    sh 'mvn test || echo "Tests failed"'
                }
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }

        // Stage 3: Quality Analysis
        stage('Run Code Analysis') {
            steps {
                script {
                    echo 'Performing SonarQube scan'
                    sh 'mvn sonar:sonar || echo "Analysis failed"'
                }
            }
        }

        // Stage 4: Security Check
        stage('Perform Security Scan') {
            steps {
                script {
                    echo 'Running OWASP Dependency Check'
                    sh 'mvn dependency-check:check || echo "Security scan failed"'
                }
            }
        }

        // Stage 5: Staging Deployment
        stage('Deploy to Staging') {
            steps {
                script {
                    echo 'Deploying to Kubernetes staging'
                    sh 'kubectl apply -f staging.yaml || echo "Staging deploy failed"'
                }
            }
        }

        // Stage 6: Staging Verification
        stage('Verify Staging Environment') {
            steps {
                script {
                    echo 'Running Postman tests on staging'
                    sh 'newman run staging-tests.json || echo "Staging tests failed"'
                }
            }
        }

        // Stage 7: Production Release
        stage('Deploy to Production') {
            steps {
                script {
                    echo 'Deploying to production cluster'
                    sh 'helm upgrade --install production ./chart || echo "Production deploy failed"'
                }
            }
        }
    }

    post {
        always {
            script {
                mail(
                    subject: "Pipeline Completed: ${JOB_NAME} #${BUILD_NUMBER}",
                    body: """Pipeline execution finished with status: ${currentBuild.currentResult}
                    
                    Details: ${BUILD_URL}
                    """,
                    to: 'angel4761.be23@chitkara.edu.in'
                )
            }
        }
    }
}
