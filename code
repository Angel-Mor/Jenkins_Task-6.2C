pipeline {
    agent any

    tools {
        maven 'M3'  // Must match exact name of Maven installation in Jenkins
    }

    stages {
        stage('Build') {
            steps {
                echo 'Building the application...'
                sh 'mvn clean package'
            }
            post {
                failure {
                    mail to: 'angel4761.be23@chitkara.edu.in',
                         subject: 'Build Failed - ${JOB_NAME}',
                         body: 'Build stage failed. Maven not found or build failed.\n\nBuild URL: ${BUILD_URL}'
                }
            }
        }

        stage('Unit and Integration Tests') {
            steps {
                echo 'Running unit and integration tests...'
                sh 'mvn test'
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                    mail to: 'angel4761.be23@chitkara.edu.in',
                         subject: 'Test Results - ${JOB_NAME}',
                         body: 'Tests completed. Status: ${currentBuild.currentResult}\n\nBuild URL: ${BUILD_URL}',
                         attachLog: true
                }
            }
        }

        stage('Code Analysis') {
            steps {
                echo 'Running code analysis...'
                sh 'mvn sonar:sonar -Dsonar.projectKey=jenkins-task'
            }
            post {
                failure {
                    mail to: 'angel4761.be23@chitkara.edu.in',
                         subject: 'Code Analysis Failed - ${JOB_NAME}',
                         body: 'Code analysis failed. Check Jenkins logs.\n\nBuild URL: ${BUILD_URL}'
                }
            }
        }

        stage('Security Scan') {
            steps {
                echo 'Running security scan...'
                sh 'mvn dependency-check:check'
            }
            post {
                always {
                    mail to: 'angel4761.be23@chitkara.edu.in',
                         subject: 'Security Scan Results - ${JOB_NAME}',
                         body: 'Security scan completed. Status: ${currentBuild.currentResult}\n\nBuild URL: ${BUILD_URL}',
                         attachLog: true
                }
            }
        }

        stage('Deploy to Staging') {
            steps {
                echo 'Deploying to staging environment...'
                sh 'echo "Simulating deployment to staging"'
            }
        }

        stage('Integration Tests on Staging') {
            steps {
                echo 'Running integration tests on staging...'
                sh 'mvn verify -Denvironment=staging'
            }
        }

        stage('Deploy to Production') {
            steps {
                echo 'Deploying to production environment...'
                sh 'echo "Simulating deployment to production"'
            }
        }
    }
}
