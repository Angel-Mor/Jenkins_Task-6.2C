pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                script {
                    echo 'Building the application...'
                    // This will work if Maven is properly configured in Jenkins
                    sh 'mvn --version'
                    sh 'mvn clean package || echo "Build failed"'
                }
            }
            post {
                failure {
                    mail to: 'angel4761.be23@chitkara.edu.in',
                         subject: "Build Failed - ${JOB_NAME}",
                         body: "The build stage failed. Please check Jenkins logs.\n\nBuild URL: ${BUILD_URL}"
                }
            }
        }

        stage('Unit and Integration Tests') {
            steps {
                script {
                    echo 'Running tests...'
                    sh 'mvn test || echo "Tests failed"'
                }
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                    mail to: 'angel4761.be23@chitkara.edu.in',
                         subject: "Test Results - ${JOB_NAME}",
                         body: "Test stage completed with status: ${currentBuild.currentResult}\n\nBuild URL: ${BUILD_URL}"
                }
            }
        }

        stage('Code Analysis') {
            steps {
                script {
                    echo 'Analyzing code...'
                    sh 'mvn sonar:sonar || echo "Code analysis failed"'
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    echo 'Scanning for vulnerabilities...'
                    sh 'mvn dependency-check:check || echo "Security scan failed"'
                }
            }
            post {
                always {
                    mail to: 'angel4761.be23@chitkara.edu.in',
                         subject: "Security Scan - ${JOB_NAME}",
                         body: "Security scan completed with status: ${currentBuild.currentResult}\n\nBuild URL: ${BUILD_URL}"
                }
            }
        }

        stage('Deploy to Staging') {
            steps {
                script {
                    echo 'Deploying to staging...'
                    sh 'echo "Simulated staging deployment"'
                }
            }
        }

        stage('Integration Tests on Staging') {
            steps {
                script {
                    echo 'Testing staging environment...'
                    sh 'echo "Simulated staging tests"'
                }
            }
        }

        stage('Deploy to Production') {
            steps {
                script {
                    echo 'Deploying to production...'
                    sh 'echo "Simulated production deployment"'
                }
            }
        }
    }
}
