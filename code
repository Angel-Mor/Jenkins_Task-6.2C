pipeline {
    agent any

    tools {
        maven 'Maven 3.8.5' // Ensure this matches your Jenkins Maven installation name
    }

    environment {
        NOTIFY_EMAIL = 'angel4761.be23@chitkara.edu.in'
    }

    stages {
        stage('Build') {
            steps {
                echo 'Building the application using Maven...'
                sh 'mvn clean package'
            }
            post {
                failure {
                    emailext(
                        subject: 'Build Failed - ${JOB_NAME}',
                        body: 'Build stage failed. Please check Jenkins logs.\n\nBuild URL: ${BUILD_URL}',
                        to: "${env.NOTIFY_EMAIL}"
                    )
                }
            }
        }

        stage('Unit and Integration Tests') {
            steps {
                echo 'Running unit and integration tests using JUnit...'
                sh 'mvn test'
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                    emailext(
                        subject: 'Test Results - ${JOB_NAME}',
                        body: 'Unit and Integration Tests completed. Status: ${currentBuild.currentResult}\n\nBuild URL: ${BUILD_URL}',
                        to: "${env.NOTIFY_EMAIL}",
                        attachmentsPattern: '**/target/surefire-reports/*.xml'
                    )
                }
            }
        }

        stage('Code Analysis') {
            steps {
                echo 'Performing static code analysis using SonarQube...'
                withSonarQubeEnv('sonar-server') {
                    sh 'mvn sonar:sonar'
                }
            }
            post {
                failure {
                    emailext(
                        subject: 'Code Analysis Failed - ${JOB_NAME}',
                        body: 'SonarQube analysis failed. Please check Jenkins logs.\n\nBuild URL: ${BUILD_URL}',
                        to: "${env.NOTIFY_EMAIL}"
                    )
                }
            }
        }

        stage('Security Scan') {
            steps {
                echo 'Running security scan using OWASP Dependency-Check...'
                dependencyCheck additionalArguments: '--scan ./ --format XML --out ./', odcInstallation: 'OWASP-DC'
                dependencyCheckPublisher pattern: 'dependency-check-report.xml'
            }
            post {
                always {
                    emailext(
                        subject: 'Security Scan Results - ${JOB_NAME}',
                        body: 'Security scan completed. Status: ${currentBuild.currentResult}\n\nBuild URL: ${BUILD_URL}',
                        to: "${env.NOTIFY_EMAIL}",
                        attachmentsPattern: 'dependency-check-report.xml'
                    )
                }
            }
        }

        stage('Deploy to Staging') {
            steps {
                echo 'Deploying application to staging server...'
                // Replace with your actual deployment commands
                sh 'echo "Simulating deployment to staging environment"'
            }
        }

        stage('Integration Tests on Staging') {
            steps {
                echo 'Running integration tests on staging...'
                sh 'mvn verify -Denvironment=staging'
            }
        }

        stage('Deploy to Production') {
            steps {
                echo 'Deploying application to production server...'
                // Replace with your actual deployment commands
                sh 'echo "Simulating deployment to production environment"'
            }
        }
    }

    post {
        always {
            echo 'Pipeline completed.'
            emailext(
                subject: 'Pipeline Completed - ${JOB_NAME} #${BUILD_NUMBER}',
                body: 'Pipeline execution finished. Final Status: ${currentBuild.currentResult}\n\nBuild URL: ${BUILD_URL}',
                to: "${env.NOTIFY_EMAIL}"
            )
        }
    }
}
